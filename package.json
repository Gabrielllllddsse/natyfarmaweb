{
  "name": "natyfarmaweb",
  "version": "1.0.0",
  "description": "Sistema web de Natyfarma: sitio público y panel de gestión (Express + MySQL + Less + Bootstrap 5)",
  "main": "server/index.js",
  "scripts": {
    "setup": "node database/setup.js",
    "start": "node server/index.js",
    "start:nube": "node database/setup.js && node server/index.js",
    "dev": "nodemon server/index.js",
    "build:css": "lessc --clean-css public/less/main.less public/css/main.css || lessc public/less/main.less public/css/main.css",
    "watch:css": "nodemon --watch public/less -e less --exec \"npm run build:css\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "less": "^4.2.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
